# Renomeie este arquivo para ".env" e preencha com seus dados reais

# Configurações do banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=ferraz_ecommerce

# Deixe "false" (ou remova a linha) ao rodar no seu computador com XAMPP/MySQL local.
# Coloque "true" quando conectar em um banco na nuvem (ex: Aiven), que exige SSL.
DB_SSL=false

# Porta em que o servidor backend vai rodar
PORT=5000

# Chave secreta usada para assinar os tokens JWT do painel admin
# Troque por uma string longa e aleatória em produção
JWT_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria
JWT_EXPIRES_IN=8h

# Origem permitida para requisições do frontend (CORS)
FRONTEND_URL=http://localhost:8080

# Endereço público do PRÓPRIO backend (necessário para o Mercado Pago
# conseguir chamar o webhook). Deixe em branco enquanto testa só localmente.
BACKEND_URL=

# Token de acesso do Mercado Pago (Checkout Pro). Enquanto ficar em branco,
# o site funciona em MODO SIMULADO: pedidos são aprovados automaticamente,
# sem cobrança real — ótimo para testar/demonstrar antes de ativar o
# gateway de verdade. Para obter o token real:
#   1. Crie uma conta em https://www.mercadopago.com.br
#   2. Acesse https://www.mercadopago.com.br/developers/panel
#   3. Crie uma aplicação e copie o "Access Token de produção"
MP_ACCESS_TOKEN=

# Public Key do Mercado Pago (fica na mesma tela do Access Token). Usada
# pelo checkout invisível (Payment Brick) no navegador do comprador — não
# é secreta, pode aparecer no código do frontend sem problema.
MP_PUBLIC_KEY=

# Configuração de e-mail (confirmação de cadastro e login em duas etapas).
# Enquanto ficar em branco, o site roda em MODO SIMULADO: o código de
# verificação aparece na tela em vez de ser enviado por e-mail de verdade —
# ótimo pra testar localmente sem precisar configurar nada.
#
# RECOMENDADO — API do Brevo: funciona em QUALQUER hospedagem, inclusive
# planos grátis como o Render, que bloqueiam o envio de e-mail tradicional
# (SMTP) por padrão. Pra pegar essa chave: entre no Brevo → "Integrações"
# → "SMTP & API" → aba "Chaves API e MCP" → gere uma nova chave.
# (Atenção: essa é uma chave DIFERENTE da chave/login SMTP usados abaixo!)
BREVO_API_KEY=

# Alternativa — SMTP tradicional: funciona bem rodando local (XAMPP), mas
# pode ser BLOQUEADO em hospedagens gratuitas como o Render (eles bloqueiam
# as portas de SMTP no plano grátis desde set/2025). Se for usar o Render
# gratuito, prefira a BREVO_API_KEY acima em vez destas variáveis.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frete real (Melhor Envio) — cotação de várias transportadoras (Correios,
# Jadlog, etc) com preço e prazo reais. Enquanto ficar em branco, o site usa
# frete fixo por região como reserva — ótimo pra testar sem configurar nada.
#   1. Crie uma conta em https://www.melhorenvio.com.br
#   2. Vá em "Integrações" → "Área Dev." → "Cadastrar aplicativo"
#   3. Preencha o formulário (a URL de callback deve ser
#      SEU_BACKEND_URL/api/frete/melhor-envio/callback)
#   4. Copie o Client ID e o Secret gerados
#   5. Depois de preencher e reiniciar o backend, entre no painel admin,
#      aba "Frete", e clique em "Conectar com Melhor Envio" pra autorizar
#      de fato (isso é um login OAuth2, parecido com "Entrar com Google" —
#      só preencher o .env não é suficiente, precisa autorizar pelo painel)
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_CEP_ORIGEM=
